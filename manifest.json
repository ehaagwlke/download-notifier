{
    "name":"__MSG_extName__",
    "version":"0.0.7",
    "description":"__MSG_description__",
    "icons":{
        "19":"img/icon-19.png",
        "32":"img/icon-32.png",
        "48":"img/icon-48.png",
        "64":"img/icon-64.png",
        "128":"img/icon-128.png"
    },
    "background":{
        "service_worker":"js/background.js"
    },
    "default_locale":"en",
    "manifest_version":3,

    "action": {
        "default_icon": {
            "16": "img/icon-16.png",
            "32": "img/icon-32.png"
        },
        "default_title": "Better Downloader",
        "default_popup": "view/popup.html"
    },

    "permissions": [
        "downloads",
        "downloads.open",
        "downloads.shelf",
        "downloads.ui",
        "notifications",
        "tabs",
        "management",
        "storage",
        "offscreen"
    ],
    "options_ui": {
        "page": "view/options.html",
        "open_in_tab": false
    },
    "minimum_chrome_version": "109"
}
